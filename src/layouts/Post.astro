---
// Port of the 2013 Jekyll post layout (_layouts/post.html).
import Base from '@/layouts/Base.astro';
import { formatDate, postPath, type Post } from '@/lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<Base>
  <div id="post">
    <h2>
      <a href={postPath(post)}>{post.data.title}</a>
    </h2>
    <p id="date">{formatDate(post.data.date)}</p>
    {post.data.aiUsage && (
      <aside class="ai-usage" aria-labelledby="ai-usage">
        <h3 id="ai-usage">AI usage</h3>
        <p>{post.data.aiUsage}</p>
      </aside>
    )}
    <slot />
  </div>
</Base>

<style>
  /* The rendered Markdown arrives through the slot, so its footnote markup
     (GFM) is styled with :global. The "Footnotes" heading is for assistive
     technology only, and the section keeps the old <hr> separator. */
  #post :global(section.footnotes) {
    border-top: 1px solid var(--color-rule);
    padding-top: 20px;
  }

  /* A boxed note between the date and the body, styled like a code block. */
  .ai-usage {
    background: var(--color-code-bg);
    border: 1px solid var(--color-rule);
    border-radius: 5px;
    padding: 8px 15px;
    margin: 0 0 20px;
  }

  .ai-usage h3 {
    font-size: inherit;
    font-weight: inherit;
    color: inherit;
    margin: 0 0 5px;
  }

  .ai-usage p {
    font-style: italic;
    margin: 0;
  }

  #post :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
